<svg data-atlas-route aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="none">
  <path class="atlas-route__halo" d="M 1120 76 C 910 182, 1140 332, 846 440 S 488 642, 596 860" pathLength="1" />
  <path class="atlas-route__line" d="M 1120 76 C 910 182, 1140 332, 846 440 S 488 642, 596 860" pathLength="1" />
</svg>

<script>
  const route = document.querySelector<SVGSVGElement>('[data-atlas-route]');
  const motionQuery = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (route && motionQuery.matches) {
    let frame = 0;

    const updateRoute = () => {
      frame = 0;
      const bounds = route.getBoundingClientRect();
      const span = Math.max(bounds.height + window.innerHeight * 0.42, 1);
      const progress = Math.min(1, Math.max(0, (window.innerHeight - bounds.top) / span));

      route.style.setProperty('--atlas-route-offset', String(1 - progress));
      route.dataset.motion = 'ready';
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateRoute);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    requestUpdate();
  }
</script>
