---
import type { StudioContent } from '@shared/content/studio';

interface Props {
  product: StudioContent['featuredProduct'];
}

const { product } = Astro.props;
---

<section class="featured-product" aria-labelledby="muslim-leveling-title">
  <div class="featured-product__content">
    <div class="featured-product__intro">
      <p class="featured-product__route" aria-label={`Route ${product.index}`}>{product.index}</p>
      <p class="featured-product__label">{product.label}</p>
      <h2 id="muslim-leveling-title">{product.name}</h2>
      <p class="featured-product__body">{product.body}</p>
    </div>

    <div class="featured-product__details">
      <ul class="featured-product__tags" aria-label={`${product.name} capabilities`}>
        {product.tags.map((tag) => <li class="featured-product__tag">{tag}</li>)}
      </ul>
      <a class="featured-product__link" href={product.href}>
        <span>{product.cta}</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
          <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
        </svg>
      </a>
    </div>
  </div>
</section>
