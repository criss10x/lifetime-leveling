---
import { localePath } from '../i18n/routes';
import { LOCALES, type Locale } from '../i18n/types';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const labels: Record<Locale, string> = {
  id: 'Bahasa Indonesia',
  en: 'English',
};
---

<nav class="locale-switcher" aria-label={locale === 'id' ? 'Pilihan bahasa' : 'Language selector'}>
  {LOCALES.map((alternateLocale) => (
    <a
      class="locale-switcher__link"
      href={localePath(alternateLocale, path)}
      aria-label={labels[alternateLocale]}
      aria-current={alternateLocale === locale ? 'page' : undefined}
    >
      {labels[alternateLocale]}
    </a>
  ))}
</nav>
