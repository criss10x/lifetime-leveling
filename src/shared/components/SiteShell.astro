---
import type { SurfaceName } from '../config/surfaces';
import type { Locale } from '../i18n/types';
import '../styles/foundations.css';
import BaseHead from './BaseHead.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  surface: SurfaceName;
  locale: Locale;
  path: string;
  title: string;
  description: string;
  image?: string;
  directionContract?: string;
}

const { surface, locale, path, title, description, image, directionContract } = Astro.props;
const skipLabel = locale === 'id' ? 'Lewati ke konten utama' : 'Skip to main content';
const escapedDirectionContract = directionContract?.replaceAll('--', '—');
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead {surface} {locale} {path} {title} {description} {image} />
  </head>
  <body data-surface={surface}>
    {import.meta.env.DEV && escapedDirectionContract && <Fragment set:html={`<!-- ${escapedDirectionContract} -->`} />}
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <header>
      <slot name="navigation">
        <LocaleSwitcher {locale} {path} />
      </slot>
    </header>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
