---
import type { SurfaceName } from '../config/surfaces';
import { LOCALES, type Locale } from '../i18n/types';
import { canonicalUrl } from '../seo/metadata';
import { getStructuredData, type ArticleMetadata } from '../seo/schema';

interface Props {
  surface: SurfaceName;
  locale: Locale;
  path: string;
  title: string;
  description: string;
  image?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  faq?: { items: readonly { question: string; answer: string }[] };
  article?: ArticleMetadata;
}

const { surface, locale, path, title, description, image, twitterCard, faq, article } = Astro.props;
const canonical = canonicalUrl(surface, locale, path);
const socialImage = image ? new URL(image, canonical).toString() : undefined;
const cardType = twitterCard ?? (image?.includes('icon') ? 'summary' : socialImage ? 'summary_large_image' : 'summary');
const structuredData = getStructuredData({ surface, locale, path, title, description, faq, article });
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/brand/muslim-leveling-icon.png" />
<link rel="apple-touch-icon" href="/brand/muslim-leveling-icon.png" />
<meta name="description" content={description} />
<script is:inline>
  // ponytail: pre-paint theme boot — read localStorage, fall back to OS preference, set on <html> so dark palette applies before first frame.
  (function () {
    try {
      var stored = localStorage.getItem('muslim-theme');
      var next = stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = next;
    } catch (e) {}
  })();
</script>
<link rel="canonical" href={canonical} />
{LOCALES.map((alternateLocale) => (
  <link
    rel="alternate"
    hreflang={alternateLocale}
    href={canonicalUrl(surface, alternateLocale, path)}
  />
))}
<link rel="alternate" hreflang="x-default" href={canonicalUrl(surface, 'id', path)} />
<meta property="og:type" content={article ? 'article' : 'website'} />
{article?.datePublished && <meta property="article:published_time" content={article.datePublished} />}
{article?.dateModified && <meta property="article:modified_time" content={article.dateModified} />}
<meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{socialImage && <meta property="og:image" content={socialImage} />}
<meta name="twitter:card" content={cardType} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
<title>{title}</title>
{structuredData.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
