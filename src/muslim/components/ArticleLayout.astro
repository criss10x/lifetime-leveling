---
import SiteShell from '@shared/components/SiteShell.astro';
import ProductNavigation from './ProductNavigation.astro';
import ProductFooter from './ProductFooter.astro';
import AndroidDownloadButton from './AndroidDownloadButton.astro';
import { muslimProductContent } from '@shared/content/muslim-product';
import { getGuides } from '@shared/content/guides';
import type { Locale } from '@shared/i18n/types';
import type { ArticleMetadata } from '@shared/seo/schema';
import '../styles/muslim.css';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  publishDateDisplay: string;
  readingTime: string;
  category: string;
  path: string;
  locale?: Locale;
  articleSchema: ArticleMetadata;
  ctaTitle?: string;
  ctaDescription?: string;
}

const {
  title,
  description,
  publishDate,
  publishDateDisplay,
  readingTime,
  category,
  path,
  locale = 'id',
  articleSchema,
  ctaTitle,
  ctaDescription,
} = Astro.props;

const content = muslimProductContent[locale];
const homeHref = locale === 'id' ? '/' : '/en/';

const defaultCtaTitle =
  locale === 'id' ? 'Jaga Konsistensi Ibadah Setiap Hari' : 'Maintain Your Worship Rhythm Every Day';
const defaultCtaDesc =
  locale === 'id'
    ? 'Download Muslim Leveling secara gratis di Android. Bangun ritme ibadah harian yang tenang melalui quest ibadah, jadwal salat presisi, Al-Quran tajwid, dan pengingat dzikir bebas iklan.'
    : 'Download Muslim Leveling for free on Android. Build a calm daily worship rhythm with quests, accurate prayer times, Quran with tajweed, and ad-free reminders.';

const finalCtaTitle = ctaTitle ?? defaultCtaTitle;
const finalCtaDesc = ctaDescription ?? defaultCtaDesc;

const currentSlug = path.replace(/^\/(?:en\/)?panduan\//, '').replace(/\/$/, '');
const relatedGuides = getGuides()
  .filter((g) => g.slug !== currentSlug)
  .slice(0, 2);
---

<SiteShell
  surface="muslim"
  {locale}
  {path}
  {title}
  {description}
  image="/brand/muslim-leveling-icon.png"
  article={articleSchema}
>
  <ProductNavigation slot="navigation" {locale} path="/panduan/" content={content} />

  <div class="article-wrapper">
    <article class="article-layout">
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={homeHref}>{locale === 'id' ? 'Beranda' : 'Home'}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={locale === 'id' ? '/panduan/' : '/en/panduan/'}>{category}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page"><span>{title}</span></li>
        </ol>
      </nav>

      <header class="article-header">
        <span class="article-category">{category}</span>
        <h1>{title}</h1>
        <div class="article-meta">
          <time datetime={publishDate}>{publishDateDisplay}</time>
          <span class="article-meta__dot" aria-hidden="true">·</span>
          <span>{readingTime}</span>
        </div>
      </header>

      <div class="article-content">
        <slot />
      </div>

      <section class="article-cta-card">
        <div class="article-cta-card__badge">Muslim Leveling Android</div>
        <h2>{finalCtaTitle}</h2>
        <p>{finalCtaDesc}</p>
        <AndroidDownloadButton href={content.googlePlayUrl} label={content.hero.cta} />
      </section>

      {relatedGuides.length > 0 && (
        <section class="article-related" aria-labelledby="related-guides-title">
          <h2 id="related-guides-title">{locale === 'id' ? 'Panduan Terkait Lainnya' : 'Related Worship Guides'}</h2>
          <div class="article-related__grid">
            {relatedGuides.map((item) => (
              <a href={locale === 'id' ? `/panduan/${item.slug}/` : `/en/panduan/${item.slug}/`} class="guide-card guide-card--related">
                <div class="guide-card__meta">
                  <span class="guide-card__category">{item.category}</span>
                  <span class="guide-card__dot" aria-hidden="true">·</span>
                  <span>{item.readingTime}</span>
                </div>
                <h3 class="guide-card__title">{item.title}</h3>
                <p class="guide-card__desc">{item.description}</p>
                <div class="guide-card__cta">
                  <span>{locale === 'id' ? 'Baca selengkapnya' : 'Read guide'}</span>
                  <span aria-hidden="true">&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </div>

  <ProductFooter {content} {locale} />
</SiteShell>

<script>
  // ponytail: theme toggle wiring + sticky header shadow on article pages
  const labels = {
    id: { dark: 'Tema gelap diaktifkan', light: 'Tema terang diaktifkan' },
    en: { dark: 'Dark theme enabled', light: 'Light theme enabled' },
  } as const;
  const t = document.documentElement.lang === 'en' ? labels.en : labels.id;

  const ready = () => {
    const body = document.body;
    const header = document.querySelector<HTMLElement>('body[data-surface="muslim"] > header');
    const floating = document.querySelector<HTMLElement>('.floating-cta');

    if (header) {
      const onScroll = () => {
        const scrolled = window.scrollY > 8;
        header.classList.toggle('is-scrolled', scrolled);
        if (floating) floating.classList.toggle('is-hidden', scrolled && window.innerWidth <= 760);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const announce = document.querySelector<HTMLElement>('[data-theme-announce]');

    if (toggle) {
      const apply = (next: string) => {
        document.documentElement.dataset.theme = next;
        body.dataset.theme = next;
        toggle.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
        if (announce) announce.textContent = next === 'dark' ? t.dark : t.light;
        try {
          localStorage.setItem('muslim-theme', next);
        } catch (e) {
          console.error('theme persist failed', e);
        }
      };

      apply(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

      toggle.addEventListener('click', () => {
        apply(body.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', ready, { once: true });
  } else {
    ready();
  }
</script>
