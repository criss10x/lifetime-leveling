---
import LocaleSwitcher from '@shared/components/LocaleSwitcher.astro';
import type { MuslimProductContent } from '@shared/content/muslim-product';
import type { Locale } from '@shared/i18n/types';

interface Props {
  locale: Locale;
  path: string;
  content: MuslimProductContent;
}

const { locale, path, content } = Astro.props;
const homeHref = locale === 'id' ? '/' : '/en/';
---

<nav class="product-navigation" aria-label={locale === 'id' ? 'Navigasi utama' : 'Primary navigation'}>
  <a class="product-navigation__brand" href={homeHref} aria-label="Muslim Leveling">
    <img src="/brand/muslim-leveling-icon.png" width="512" height="512" alt="" decoding="async" />
    <span>{content.navigation.product}</span>
  </a>
  <nav class="product-navigation__sections" aria-label={locale === 'id' ? 'Lompat ke bagian' : 'Jump to section'}>
    <a href="#feature-catalog-title">{locale === 'id' ? 'Fitur' : 'Features'}</a>
    <a href="#quran-murottal-title">{locale === 'id' ? 'Layar' : 'Screens'}</a>
    <a href="#privacy-title">{locale === 'id' ? 'Privasi' : 'Privacy'}</a>
  </nav>
  <div class="product-navigation__actions">
    <span class="product-navigation__platform">{content.navigation.android}</span>
    <LocaleSwitcher {locale} {path} />
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label={locale === 'id' ? 'Alihkan tema terang atau gelap' : 'Toggle light or dark theme'}
      aria-describedby="theme-announce"
      aria-pressed="false"
      title={locale === 'id' ? 'Alihkan tema' : 'Toggle theme'}
    >
      <svg class="theme-toggle__sun" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.5v2.4M12 19.1v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7" />
      </svg>
      <svg class="theme-toggle__moon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
      </svg>
    </button>
    <span id="theme-announce" class="visually-hidden" aria-live="polite" data-theme-announce></span>
    <a
      class="product-navigation__cta"
      href={content.googlePlayUrl}
      target="_blank"
      rel="noreferrer"
      data-sticky-cta="desktop"
    >{content.hero.cta}</a>
  </div>
</nav>
<a
  class="floating-cta"
  href={content.googlePlayUrl}
  target="_blank"
  rel="noreferrer"
  aria-label={content.hero.cta}
  data-sticky-cta="mobile"
>
  <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 7.5c2.2-1.2 4.5-2 7-2s4.8.8 7 2v9c-2.2-1.2-4.5-2-7-2s-4.8.8-7 2v-9Z" />
    <path d="M19 7.5c-2.2-1.2-4.5-2-7-2s-4.8.8-7 2v9c2.2-1.2 4.5-2 7-2s4.8.8 7 2v-9Z" />
    <path d="M9.5 12.5l1.4 1.4 2.8-2.9" />
  </svg>
  <span>{content.hero.cta}</span>
</a>
