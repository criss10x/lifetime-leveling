---
interface Props {
  href: string;
  label: string;
  variant?: 'default' | 'hero';
}

const { href, label, variant = 'default' } = Astro.props;
const className = variant === 'hero' ? 'android-download android-download--hero' : 'android-download';
---

<a class={className} href={href} target="_blank" rel="noreferrer">{label}</a>
