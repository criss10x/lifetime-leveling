---
import SiteShell from '@shared/components/SiteShell.astro';
import type { MuslimProductContent } from '@shared/content/muslim-product';
import type { Locale } from '@shared/i18n/types';
import ProductNavigation from './ProductNavigation.astro';
import '../styles/muslim.css';

interface Props {
  locale: Locale;
  path: string;
  content: MuslimProductContent;
}

const { locale, path, content } = Astro.props;
const directionContract = `THESIS: A proof-led poster sequence that refuses a gallery of interchangeable app cards.
OWN-WORLD: Emerald and deep-green fields, warm-white reading space, gold only for attention and progress, and supplied Android campaign posters.
STORY: Understand daily support, then see prayer timing, progress, Quran, learning, theme choice, compassion, privacy, and act through Google Play.
FIRST VIEWPORT: Product identity and Google Play action pair with the tall Home poster on a mobile-first opening; desktop balances copy and proof.
FORM: Grounded poster composition; written benefits sit beside authentic proof, every later section changes scale or composition.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;

---

<SiteShell
  surface="muslim"
  {locale}
  {path}
  title={content.meta.title}
  description={content.meta.description}
  image="/brand/muslim-leveling-icon.png"
  {directionContract}
>
  <ProductNavigation slot="navigation" {locale} {path} {content} />
  <slot />
</SiteShell>

<script>
  // ponytail: scroll-reveal + sticky header shadow + mobile CTA show/hide + theme toggle wiring. ~60 LOC, no deps.
  const ready = () => {
    const body = document.body;
    const header = document.querySelector<HTMLElement>('body[data-surface="muslim"] > header');
    const floating = document.querySelector<HTMLElement>('.floating-cta');
    if (header) {
      const onScroll = () => {
        const scrolled = window.scrollY > 8;
        header.classList.toggle('is-scrolled', scrolled);
        if (floating) floating.classList.toggle('is-hidden', scrolled && window.innerWidth <= 760);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (toggle) {
      const apply = (next: string) => {
        document.documentElement.dataset.theme = next;
        body.dataset.theme = next;
        toggle.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
        try { localStorage.setItem('muslim-theme', next); } catch (e) { console.error('theme persist failed', e); }
      };
      apply(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      toggle.addEventListener('click', () => {
        apply(body.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    }

    const motionQuery = window.matchMedia('(prefers-reduced-motion: no-preference)');
    const targets = document.querySelectorAll<HTMLElement>(
      '.feature-catalog, .daily-loop, .screenshot-story, .compassion-section, .privacy-facts',
    );
    targets.forEach((el) => el.classList.add('reveal'));
    if (motionQuery.matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal--in');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
      );
      targets.forEach((el) => io.observe(el));
    } else {
      targets.forEach((el) => el.classList.add('reveal--in'));
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', ready, { once: true });
  } else {
    ready();
  }
</script>
