---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  priority?: boolean;
}

const { image, alt, priority = false } = Astro.props;
---

<figure class="android-frame">
  <Image src={image} alt={alt} format="webp" loading={priority ? 'eager' : 'lazy'} decoding="async" />
</figure>
