---
import type { ImageMetadata } from 'astro';
import type { MuslimProductContent } from '@shared/content/muslim-product';
import AndroidFrame from './AndroidFrame.astro';

interface Props {
  content: MuslimProductContent;
  image: ImageMetadata;
}

const { content, image } = Astro.props;
const schedule = content.screenshots[1];
---

<section class="daily-loop" aria-labelledby="daily-loop-title">
  <div class="daily-loop__content">
    <div>
      <h2 id="daily-loop-title">{content.dailyLoop.title}</h2>
      <p>{content.dailyLoop.body}</p>
      <ol>
        {content.dailyLoop.steps.map((step) => (
          <li><strong>{step.title}</strong><span>{step.body}</span></li>
        ))}
      </ol>
    </div>
    <div class="daily-loop__proof">
      <AndroidFrame {image} alt={schedule.alt} />
      <p class="daily-loop__caption">{schedule.body}</p>
    </div>
  </div>
</section>
