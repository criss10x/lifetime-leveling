---
import type { ImageMetadata } from 'astro';
import type { MuslimProductContent } from '@shared/content/muslim-product';
import AndroidDownloadButton from './AndroidDownloadButton.astro';

interface Props {
  content: MuslimProductContent;
  image: ImageMetadata;
}

const { content } = Astro.props;
---

<section class="product-hero" aria-labelledby="product-hero-title">
  <!-- ponytail: user-provided photo background (converted to WebP) -->
  <img class="product-hero__bg-photo" src="/hero/background-hero.webp" alt="" aria-hidden="true" width="1920" height="1072" loading="eager" fetchpriority="high" />
  <!-- ponytail: subtle brand-colored sparkling particles (emerald + gold), rising, CSS-only -->
  <div class="product-hero__particles" aria-hidden="true">
    <span class="sparkle sparkle--1"></span>
    <span class="sparkle sparkle--2"></span>
    <span class="sparkle sparkle--3"></span>
    <span class="sparkle sparkle--4"></span>
    <span class="sparkle sparkle--5"></span>
    <span class="sparkle sparkle--6"></span>
    <span class="sparkle sparkle--7"></span>
    <span class="sparkle sparkle--8"></span>
  </div>
  <div class="product-hero__bg-overlay"></div>
  <div class="product-hero__grid product-hero__grid--solo">
    <div class="product-hero__copy">
      <p class="product-hero__eyebrow">{content.hero.eyebrow}</p>
      <h1 id="product-hero-title">{content.hero.title}</h1>
      <p class="product-hero__tagline">{content.hero.tagline}</p>
      <AndroidDownloadButton href={content.googlePlayUrl} label={content.hero.cta} variant="hero" />
      <ul class="product-hero__quick">
        {content.hero.features.slice(0, 2).map((feature) => <li>{feature}</li>)}
      </ul>
      <small>{content.hero.note}</small>
    </div>
  </div>
</section>
