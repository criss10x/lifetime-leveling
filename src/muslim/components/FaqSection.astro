---
import type { MuslimProductContent } from '@shared/content/muslim-product';

interface Props {
  content: MuslimProductContent;
}

const { content } = Astro.props;
const { faq } = content;
---

<section class="faq-section" aria-labelledby="faq-title">
  <div class="faq-section__header">
    <h2 id="faq-title">{faq.title}</h2>
    <p>{faq.body}</p>
  </div>
  <div class="faq-list">
    {faq.items.map((item, index) => (
      <details class="faq-item" open={index === 0}>
        <summary class="faq-item__trigger">
          <span class="faq-item__question">{item.question}</span>
          <svg
            class="faq-item__chevron"
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </summary>
        <div class="faq-item__content">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
